rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is admin
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/adminUsers/$(request.auth.token.email));
    }
    
    // Function to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Admin Users collection
    match /adminUsers/{email} {
      allow read, write: if isAdmin();
    }

    // Products (Public read, Admin write)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories (Public read, Admin write)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders (User can read/write their own, Admin can read/write all)
    match /orders/{orderId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // Wishlists (User can read/write their own)
    match /wishlists/{wishlistId} {
      allow read, write: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }
    
    // Reviews (Public read, Auth user create, Admin delete)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    // CMS/Settings (Admin only)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Inquiries/Contact (Public create, Admin read/write)
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    // Fallback block - deny everything else
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
