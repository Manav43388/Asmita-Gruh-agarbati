rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Relaxed rule: allow authenticated users to upload images.
    // This avoids cross-service IAM role issues that cause uploads to hang.
    match /{allPaths=**} {
      allow read: if true;
      allow write, delete: if request.auth != null;
    }
    
    // Allow users to upload their own avatars or specific files if needed,
    // but in this eCommerce app, generally only admins upload images.
  }
}
